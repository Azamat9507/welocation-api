# Copy to .env and fill in what you need. .env is git-ignored; never commit real values.
# docker compose reads .env from this folder. For ./gradlew bootRun, export it first:
#   set -a; . ./.env; set +a; ./gradlew bootRun
# Lines left commented out fall back to the laptop defaults in compose.yaml and application.yml.
# Uncomment a line only with a value: Spring takes an empty variable as an empty value, not as "use the default".
# The prod profile has no defaults of its own and stops if a connection setting or JWT_SECRET is missing or empty.
# The compose app service passes laptop defaults for the passwords, so on a server set every value here.

# MySQL
# DB_URL=jdbc:mysql://localhost:3306/welocation
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# Redis
# REDIS_HOST=localhost
# REDIS_PORT=6380
# REDIS_PASSWORD=

# JWT signing key: base64, at least 256 bits. Generate one with: openssl rand -base64 32
# Required by the compose app service (prod profile).
JWT_SECRET=

# Korea Tourism Organization TourAPI service key from data.go.kr. Empty turns the nightly sync off.
TOURAPI_KEY=

# Gemini API key from Google AI Studio (aistudio.google.com). Empty turns the AI guide off (503); nothing else changes.
GEMINI_API_KEY=

# Proxies allowed to tell the API the client's IP through X-Forwarded-For (CIDR, comma separated). Default: loopback.
# Set it to the web server's or nginx's address when they run on another host or container.
# TRUSTED_PROXIES=

# Host ports published by compose.yaml
# MYSQL_PORT=3306
# REDIS_HOST_PORT=6380
# APP_PORT=8080
